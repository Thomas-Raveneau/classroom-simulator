[connection signal="pressed" from="Margin/Layout/Buttons/BackButton" to="." method="_on_back_button_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/RefreshButton" to="." method="_on_refresh_button_pressed"]
